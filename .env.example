# Kairos — operator configuration.
#
#   cp .env.example .env
#
# `.env` is gitignored and excluded from the Docker build context, so it is never
# committed (obligation S4) and never lands in an image layer. Compose reads it
# automatically for ${VAR} interpolation.
#
# Nothing in here has a default that works "safely by accident". Where a value
# is security-relevant it is marked REQUIRED and compose refuses to start
# without it (`:?` syntax).

# ── Default topology (podman compose up -d) ────────────────────────────────

# Loopback only. Set to 0.0.0.0 ONLY if a reverse proxy is listening in front of
# Kairos and you understand that demo auth has no identity check at all.
KAIROS_BIND=127.0.0.1
# Host-side port. The in-container port stays 8003; remap here, not there
# (changing the in-container port means overriding CMD *and* healthcheck).
KAIROS_PUBLISHED_PORT=8003

# Bearer key for the REST API / MCP surface. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the API-key surface entirely (the web UI still works).
KAIROS_API_KEY=

# Public origin used in share links and .ics deep links. Leave empty only
# without a proxy; behind one, set it or links will be built from internal hosts.
KAIROS_PUBLIC_URL=

# ── MariaDB overlay (-f compose.yaml -f compose.mysql.yaml) ───────────────

KAIROS_DB_NAME=kairos
KAIROS_DB_USER=kairos
# REQUIRED. Goes into a URL, so percent-encode @ : / ? # % &.
#   python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
KAIROS_DB_PASSWORD=
# REQUIRED. Same generator. Only ever used to bootstrap the container.
KAIROS_DB_ROOT_PASSWORD=

# ── Proxy topology (podman compose -f compose.proxy.yaml up -d) ────────────
#
# NOT an overlay of compose.yaml: `-f compose.yaml -f compose.proxy.yaml` fails
# to validate (duplicate security_opt entries), and removing the duplicate to
# force it through leaves the base file's published app port in place, which
# defeats the trusted-proxy allowlist. compose.proxy.yaml is standalone.

# REQUIRED: the hostname you serve Kairos on, e.g. polls.example.org.
KAIROS_SITE=
# REQUIRED: the ACME account contact. Caddy warns about expiring certs here.
ACME_EMAIL=
# REQUIRED: the OIDC discovery base, e.g. https://id.example.org/realms/main
OIDC_ISSUER_URL=
# REQUIRED: client id/secret from your IdP's app registration.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# REQUIRED: must match the redirect URI registered on the IdP, exactly:
#   https://${KAIROS_SITE}/oauth2/callback
# A mismatch here loops forever on sign-in and is the most common setup failure.
OIDC_REDIRECT_URL=
# REQUIRED: only these email domains may become poll owners (the proxy's gate).
# This is a DOMAIN LIST, not a secret — put your real one:
#   example.org
# (or comma-separated: example.org,subsidiary.example.org). It feeds
# oauth2-proxy's --email-domain, so leaving it empty is not "allow everyone", it
# is "nobody gets in": every sign-in is refused at the proxy with no useful
# error. Hence empty here, so compose's required-variable check catches it.
OIDC_ALLOWED_DOMAINS=
# REQUIRED: cookie signing key for oauth2-proxy.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH2_PROXY_COOKIE_SECRET=

# REQUIRED: Kairos's own cookie/CSRF signing key. Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every session, response-edit token and invite
# signature in flight — respondents get signed-out mid-poll.
SESSION_SECRET=

# OPTIONAL: second owner gate, evaluated inside Kairos even for identities the
# proxy vouched for. Comma-separated uids or emails. Empty = any identity from
# the IdP may own polls. Set it to your intended user list.
KAIROS_ALLOW=

# OPTIONAL: legal pages (/imprint, /privacy) only render when the operator is
# named. If you are running this as an institution, you are the operator.
# KAIROS_OPERATOR=
# KAIROS_OPERATOR_ADDRESS=
# KAIROS_OPERATOR_EMAIL=

# ── First-party OIDC topology (podman compose -f compose.oidc.yaml up -d) ──
#
# The same app, with Kairos itself as the OIDC client: Caddy for TLS, and no
# auth-proxy container to operate. Use THIS one unless you already run Shibboleth,
# OpenAthens or oauth2-proxy and would rather keep OIDC termination in front of
# Kairos — that is compose.proxy.yaml above.
#
# Any OIDC provider works: Google, Microsoft, Authentik, Keycloak, Zitadel,
# Authelia's own endpoint. Two provider-specific notes:
#   * Google needs console setup: create a project, an OAuth client of type
#     "Web application", and add the redirect URI as an *Authorized redirect
#     URI* by hand. Changes can take minutes to hours to apply. Authentik and
#     Keycloak accept any number of redirect URIs in the app config, no console.
#   * GitHub does not implement OIDC for user sign-in (no discovery document, no
#     id_token), so it cannot back this mode. Use compose.proxy.yaml, which can.
# Full guide: docs/design/oidc-login.md

# REQUIRED: the issuer identifier, verbatim — it must equal the `issuer` value in
# your provider's discovery document, or every sign-in fails at boot.
KAIROS_OIDC_ISSUER=
# REQUIRED: client id from your IdP's app registration.
KAIROS_OIDC_CLIENT_ID=
# Leave empty ONLY for a client registered as public (PKCE still applies); a
# confidential client needs it or the token exchange is refused.
KAIROS_OIDC_CLIENT_SECRET=
# OPTIONAL: the redirect URI, which must match the one registered on the IdP
# exactly. Derived from KAIROS_PUBLIC_URL + KAIROS_PREFIX when unset. Setting it
# is the safer habit — this is the string to register:
#   https://${KAIROS_SITE}/oidc/callback
# (or, with KAIROS_PREFIX set, https://${KAIROS_SITE}/scheduler/oidc/callback)
KAIROS_OIDC_REDIRECT_URI=

# REQUIRED (one of the two): the owner allowlist. Kairos denies by default and
# REFUSES TO BOOT if both are empty — it will not admit "anyone the IdP vouched
# for". Comma-separated exact `sub` values, which you read from the provider's
# own console for the account you mean to admit. This is the strong form.
KAIROS_OIDC_ALLOWED_SUBJECTS=
# OPTIONAL: the coarse form — every account with a *verified* address at these
# comma-separated domains may own polls. Convenient, and it trusts that anyone
# who can authenticate at the IdP with such an address is one of yours.
KAIROS_OIDC_ALLOWED_EMAIL_DOMAINS=

# OPTIONAL: token-endpoint client authentication. `post` (secrets in the form
# body) is what the hosted providers document; `basic` is what the self-hosted
# ones default to. Flip to `basic` if the exchange returns invalid_client.
KAIROS_OIDC_CLIENT_AUTH=
# OPTIONAL: extra scopes beyond `openid email profile`.
KAIROS_OIDC_SCOPES=
# OPTIONAL: accept an UNVERIFIED email claim for the domain allowlist. Off by
# default; only for an IdP that does not assert email_verified at all.
KAIROS_OIDC_TRUST_UNVERIFIED_EMAIL=
