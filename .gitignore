.venv/
.direnv/
__pycache__/
*.pyc
# Databases. The pattern, not the one filename: `kairos.db` was named specifically,
# which is why a probe's `scoped.db` — a real poll row, tokens and all — was committed
# by a review that had just checked for secrets. gitleaks does not read strings inside
# a SQLite file, so the ignore rule is the only thing standing there. The -wal/-shm
# siblings ride along for the same reason.
*.db
*.db-wal
*.db-shm
node_modules/
dist/
.pytest_cache/
site/playground/wheels/
site/playground/wheels.json

# Operator secrets for the container stack (obligation S4). `.env` is read
# automatically by compose and is excluded from the Docker build context, so a
# session secret lives in exactly one place and never in a layer or a commit.
# Ship `.env.example` instead.
/.env
/.env.*
!/.env.example

# Local agent tooling config (machine-specific Nix store paths) — not portable
/opencode.json
